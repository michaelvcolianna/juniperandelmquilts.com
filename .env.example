# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Every variable here is SERVER-SIDE ONLY. None of them may be given a PUBLIC_
# prefix — that is exactly the mistake the old Nuxt build made with the Brevo
# key, which shipped in the browser bundle for three years.

# ---------------------------------------------------------------------------
# Storyblok — https://app.storyblok.com → Settings → Access Tokens
# ---------------------------------------------------------------------------
# "Preview" token; reads draft content. Used by /preview for the Visual Editor.
STORYBLOK_PREVIEW_TOKEN=
# "Public" token; reads published content. Used for the prerendered build.
STORYBLOK_PUBLIC_TOKEN=

# Management token, for the schema CLI only (`npm run schema:*`). This is NOT
# used by the site at runtime and must never be given a PUBLIC_ prefix — it can
# modify the space. Create at: My Account -> Personal access tokens.
# The CLI also accepts `npx storyblok login` instead of this variable.
STORYBLOK_PERSONAL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# EmailOctopus — https://emailoctopus.com → Account → Integrations & API
# ---------------------------------------------------------------------------
# Enable double opt-in on the list before going live:
#   Lists → (your list) → Settings → Double opt-in
EMAILOCTOPUS_API_KEY=
# The list UUID, visible in the list's URL.
EMAILOCTOPUS_LIST_ID=

# ---------------------------------------------------------------------------
# Square — https://developer.squareup.com/apps → your app → Credentials
# ---------------------------------------------------------------------------
# Start with the SANDBOX access token and location; switch at cutover.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox
